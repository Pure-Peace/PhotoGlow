{
  "name": "@photoglow/admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run --env-file=../.env next dev -p 8081 --turbopack",
    "dev:legacy": "bun run --env-file=../.env next dev -p 8081",
    "build": "bun run --env-file=../.env next build",
    "start": "bun run --env-file=../.env next start -p 8081",
    "lint": "bun run --env-file=../.env next lint",
    "fmt": "prettier . --write",
    "type-check": "tsc --noEmit",
    "create-admin": "bun run --env-file=../.env scripts/create-admin.ts",
    "db:generate": "bun run --env-file=../.env prisma generate",
    "db:migrate": "bun run --env-file=../.env prisma migrate dev --name dev",
    "db:reset": "bun run --env-file=../.env prisma migrate reset",
    "db:push": "bun run --env-file=../.env prisma db push",
    "db:pull": "bun run --env-file=../.env prisma db pull"  },
