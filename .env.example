# Application Configuration
SERVER_PORT=8001
FRONTEND_URL=http://localhost
INTERNAL_API_URL=http://server:8001
NEXT_PUBLIC_API_URL=http://localhost

# PostgreSQL
DATABASE_URL="postgresql://postgres:123456@localhost:5432/photoglow?schema=public"
ADMIN_DATABASE_URL="postgresql://postgres:123456@localhost:5432/photoglow_admin?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET="YOUR_SECRET_KEY"
JWT_EXPIRES_IN="7d"

# AWS S3 configuration
AWS_S3_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_S3_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
AWS_S3_BUCKET="photoglow-test"
AWS_S3_REGION="eu-west-2"

# AWS SES configuration
AWS_SES_ACCESS_KEY_ID=""
AWS_SES_SECRET_ACCESS_KEY=""
AWS_SES_REGION="eu-west-2"

# Google oauth
GOOGLE_OAUTH_CLIENT_ID="CLIENT_ID"
GOOGLE_OAUTH_CLIENT_SECRET="CLIENT_KEY"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:8001/api/v1/auth/google/callback"

# PostgreSQL Configuration (for Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=photoglow
