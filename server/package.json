{
  "name": "@photoglow/server",
  "private": true,
  "type": "module",
  "module": "src/main.ts",
  "scripts": {
    "build": "NODE_ENV=production bun run --env-file=../.env scripts/build.ts",
    "generate-swagger": "bun run --env-file=../.env src/generateSwagger.ts",
    "fmt": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "start": "NODE_ENV=development tsc && bun --env-file=../.env .",
    "start:dev": "NODE_ENV=development tsc-watch --onSuccess \"bun --env-file=../.env .\"",
    "start:debug": "NODE_ENV=development tsc-watch --onSuccess \"bun --env-file=../.env . --inspect\"",
    "start:prod": "NODE_ENV=production bun --env-file=../.env run dist/main.js",
    "test": "bun --env-file=../.env test",
    "test:watch": "bun --env-file=../.env test --watch",
    "test:cov": "bun --env-file=../.env test --coverage",
    "test:debug": "bun --env-file=../.env --inspect-brk --runInBand",
    "test:e2e": "bun run --env-file=../.env db:migrate && bun --env-file=../.env test ./test/app.e2e-spec.ts",
    "create-mail-template": "bun run --env-file=../.env scripts/createMailTemplate.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/client-ses": "^3.787.0",
    "@aws-sdk/lib-storage": "^3.787.0",
    "@nestjs/apollo": "^13.0.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/graphql": "^13.0.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/platform-socket.io": "^11.0.20",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.0.7",
    "@nestjs/websockets": "^11.0.20",
    "@photoglow/database": "workspace:*",
    "@photoglow/shared": "workspace:*",
    "@types/cookie-parser": "^1.4.8",
    "@types/multer": "^1.4.12",
    "@types/uuid": "^10.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "googleapis": "^148.0.0",
    "graphql": "^16.10.0",
    "ioredis": "^5.6.0",
    "ms": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/bun": "^1.1.13",
    "@types/express": "^5.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0",
    "tsc-watch": "^6.2.1",
    "typescript": "^5.1.3"
  },
  "trustedDependencies": [
    "@nestjs/core"
  ]
}